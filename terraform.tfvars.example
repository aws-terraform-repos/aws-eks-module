# Example Terraform variables file
# Copy this file to terraform.tfvars and customize the values

# Cluster Configuration
cluster_name    = "my-eks-cluster"
cluster_version = "1.32"

# VPC Discovery - Choose ONE of the following approaches:

# Option 1: Discover VPC by name tag (Recommended)
vpc_name = "my-vpc"

# Option 2: Discover VPC by custom tags (Alternative)
# vpc_tags = {
#   Environment = "production"
#   Team        = "platform"
# }

# Option 3: Explicit VPC ID (Direct specification)
# vpc_id = "vpc-12345678"

# Subnet Discovery Configuration
# Default: Uses subnets tagged with kubernetes.io/role/internal-elb = "1"
# subnet_tags = {
#   "kubernetes.io/role/internal-elb" = "1"
# }

# Alternative: Use custom subnet tags
# subnet_tags = {
#   Type        = "private"
#   Environment = "production"
# }

# Alternative: Explicit subnet IDs
# subnet_ids = ["subnet-12345678", "subnet-87654321", "subnet-abcdef12"]

# Node Group Configuration
node_group_instance_types = ["t3.medium"]
node_group_desired_size   = 2
node_group_max_size       = 4
node_group_min_size       = 1
node_group_capacity_type  = "ON_DEMAND"
node_group_ami_type       = "AL2023_x86_64_STANDARD"  # Required for Kubernetes 1.32+
node_group_disk_size      = 20

# Security Configuration
endpoint_private_access = true
endpoint_public_access  = true

# IMPORTANT: Restrict API access to your IP for security
# Get your IP: curl ifconfig.me
public_access_cidrs = ["203.0.113.0/32"]  # Replace with your actual IP

# Cluster Logging
enable_cluster_log_types = ["api", "audit", "authenticator", "controllerManager", "scheduler"]

# SSH Access (Optional - disabled by default for security)
enable_ssh_access = false
# ssh_access_cidrs  = ["203.0.113.0/32"]  # Replace with your IP if enabling SSH
# ssh_key_name      = "my-ec2-keypair"     # Your EC2 key pair name

# IRSA and Add-ons
enable_irsa                     = true
enable_addon_version_management = true

# ExternalDNS Configuration (Optional)
# Specify Route53 zones that ExternalDNS can manage (more secure than wildcard)
external_dns_zone_ids = []
# external_dns_zone_ids = ["Z1D633PJN98FT9", "Z3M3LMPEXAMPLE"]

# Domain filters for ExternalDNS
external_dns_domain_filters = []
# external_dns_domain_filters = ["example.com", "internal.example.com"]

# ExternalDNS policy
external_dns_policy = "upsert-only"  # Options: "upsert-only" or "sync"

# Route53 Hosted Zone Configuration
create_hosted_zones = false  # Set to true to create hosted zones

# Example: Create hosted zones for your domains
# hosted_zone_domains = ["example.com", "api.example.com"]

# Example: Create subdomain zones under a primary domain
# create_subdomain_zones = true
# primary_domain = "example.com"
# subdomain_zones = ["dev", "staging", "prod", "api"]
# parent_zone_id = "Z1D633PJN98FT9"  # If parent zone is managed elsewhere

# External DNS and Load Balancer Configuration
enable_load_balancer_controller = true
enable_external_dns = true

# ExternalDNS Configuration
external_dns_source = ["ingress", "service"]
external_dns_provider = "aws"
external_dns_log_level = "info"

# Tags applied to all resources
tags = {
  Environment = "development"
  Project     = "my-project"
  ManagedBy   = "terraform"
  Owner       = "my-team"
  CostCenter  = "engineering"
}